<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:ACadSharp.Viewer"
             x:Class="ACadSharp.Viewer.App"
             RequestedThemeVariant="Dark">
    <!-- App design tokens merge BEFORE the FluentAvaloniaTheme style so the
         token dictionary layers on top of the theme's own resources. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:DesignTokens />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <sty:FluentAvaloniaTheme />
    </Application.Styles>
</Application>
