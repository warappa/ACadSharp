<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:ACadSharp.Viewer.Services"
        x:Class="ACadSharp.Viewer.Controls.BlockPropertiesTableDialog"
        Title="Block properties tables"
        Width="900" Height="600"
        MinWidth="640" MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Header strip (mirrors the NodeViewerDialog header). -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="Header" FontWeight="SemiBold" FontSize="{StaticResource SubtitleFontSize}"
                      TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Left: the document's tables (a table is a standalone object; a file
             holds one per dynamic block that defines a properties table). -->
        <Border DockPanel.Dock="Left" Width="220" Padding="8"
                BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="4,0,4,4"
                           Text="Tables in document" FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextFillColorTertiary}" />
                <ListBox x:Name="TableList" SelectionChanged="OnTableSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="svc:BptTableItem">
                            <StackPanel Spacing="2" Margin="4,6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextFillColorTertiary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: the selected table's decoded data (header fields, the
             schema-dependent records, and the decoded string pool). -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" Spacing="{StaticResource Space6}">
                <!-- Header fields: the block-element prefix + the decode positions.
                     Contained card (like the tree pane's legend): a subtle fill +
                     border + the in-page corner (4). -->
                <Border CornerRadius="{StaticResource CardCornerRadius}" Padding="12,10"
                        Background="{DynamicResource CardBackgroundFillColorDefault}"
                        BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,12,6">
                            <TextBlock Text="be_major" FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock x:Name="BeMajorValue" FontFamily="{StaticResource FontFamilyCode}"
                                       FontSize="{StaticResource CodeFontSize}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,12,6">
                            <TextBlock Text="be_minor" FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock x:Name="BeMinorValue" FontFamily="{StaticResource FontFamilyCode}"
                                       FontSize="{StaticResource CodeFontSize}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                            <TextBlock Text="eed1071" FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock x:Name="Eed1071Value" FontFamily="{StaticResource FontFamilyCode}"
                                       FontSize="{StaticResource CodeFontSize}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="raw tail (bits)" FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock x:Name="RawBitsValue" FontFamily="{StaticResource FontFamilyCode}"
                                       FontSize="{StaticResource CodeFontSize}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Text="string pool start (bit)" FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock x:Name="PoolStartValue" FontFamily="{StaticResource FontFamilyCode}"
                                       FontSize="{StaticResource CodeFontSize}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                            <TextBlock Text="strings" FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock x:Name="StringCountValue" FontFamily="{StaticResource FontFamilyCode}"
                                       FontSize="{StaticResource CodeFontSize}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Records: schema-dependent (the note above the grid says which
                     schema matched and what the columns mean for it). -->
                <StackPanel Spacing="{StaticResource Space4}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                        <TextBlock Text="Records" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" />
                        <TextBlock x:Name="SchemaTag" FontSize="{StaticResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextFillColorSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="RecordsNote" FontSize="{StaticResource CaptionFontSize}"
                               Foreground="{DynamicResource TextFillColorSecondary}" TextWrapping="Wrap" />
                    <DataGrid x:Name="RecordsGrid" x:DataType="svc:BptRecordItem" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:BptRecordItem">
                                        <TextBlock Text="{Binding Index}" FontFamily="{StaticResource FontFamilyCode}"
                                                   FontSize="{StaticResource CodeFontSize}" Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Label index" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:BptRecordItem">
                                        <TextBlock Text="{Binding LabelIndex}" FontFamily="{StaticResource FontFamilyCode}"
                                                   FontSize="{StaticResource CodeFontSize}" Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Label" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:BptRecordItem">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Value index" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:BptRecordItem">
                                        <TextBlock Text="{Binding ValueIndex}" FontFamily="{StaticResource FontFamilyCode}"
                                                   FontSize="{StaticResource CodeFontSize}" Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Value" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:BptRecordItem">
                                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- The decoded string pool (the interned UTF-16LE strings the
                     records reference). -->
                <StackPanel Spacing="{StaticResource Space4}">
                    <TextBlock x:Name="PoolHeader" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" />
                    <DataGrid x:Name="PoolGrid" x:DataType="svc:BptStringItem" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:BptStringItem">
                                        <TextBlock Text="{Binding Index}" FontFamily="{StaticResource FontFamilyCode}"
                                                   FontSize="{StaticResource CodeFontSize}" Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="String" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="svc:BptStringItem">
                                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="6,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
