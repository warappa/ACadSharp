<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ACadSharp.Viewer.Controls.NodeGraphView">
    <Grid>
        <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="GraphCanvas" Background="Transparent" MinWidth="400" MinHeight="300" />
        </ScrollViewer>
        <!-- Hover tooltip for edges (Avalonia 12 removed ToolTipService, so this is
             a small floating card positioned at the pointer). -->
        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Border x:Name="EdgeTip" IsVisible="False" CornerRadius="6" Padding="8,5"
                    Background="{DynamicResource SolidBackgroundFillColorBase}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1">
                <TextBlock x:Name="EdgeTipText" FontSize="12" TextWrapping="Wrap" MaxWidth="260" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
