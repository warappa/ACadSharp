<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ACadSharp.Viewer.Controls.NodeGraphView">
    <Grid>
        <!-- Scrollbars are disabled: zoom and pan are driven by a manual
             scale+translate transform on the canvas (see ApplyScale), which
             works at any window size. The viewer still clips the canvas to
             the viewport. -->
        <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <!-- Opaque background = the window background color (verified
                 identical in both themes), so the canvas fills the whole
                 viewport seamlessly and the edge-label mask blends in. -->
            <Canvas x:Name="GraphCanvas" Background="{DynamicResource SolidBackgroundFillColorBase}" MinWidth="400" MinHeight="300" />
        </ScrollViewer>
        <!-- Hover tooltip for nodes and edges (Avalonia 12 removed ToolTipService,
             so this is a small floating card positioned at the pointer). -->
        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Border x:Name="HoverTip" IsVisible="False" CornerRadius="6" Padding="8,5"
                    Background="{DynamicResource SolidBackgroundFillColorBase}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1">
                <TextBlock x:Name="HoverTipText" FontSize="12" TextWrapping="Wrap" MaxWidth="260" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
