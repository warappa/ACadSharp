<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:local="using:ACadSharp.Viewer.Controls"
        x:Class="ACadSharp.Viewer.Controls.NodeViewerDialog"
        Title="Node viewer"
        Width="900" Height="600"
        MinWidth="500" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Zoom controls (the legends moved into the graph area as a
                     non-interactive overlay, see the Grid below). -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Click="OnFitClick" Focusable="False">
                        <ui:FASymbolIcon Symbol="FullScreen" />
                    </Button>
                    <Button Click="OnZoomInClick" Focusable="False">
                        <ui:FASymbolIcon Symbol="ZoomIn" />
                    </Button>
                    <Button Click="OnZoomOutClick" Focusable="False">
                        <ui:FASymbolIcon Symbol="ZoomOut" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="Header" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="Details" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondary}"
                       Text="Click a node to see its details. Hover a node or edge for a quick summary. Scroll to zoom, drag to pan." />
        </Border>
        <Grid>
            <local:NodeGraphView x:Name="Graph" />
            <!-- Legends (node + line types): an overlay over the graph area.
                 IsHitTestVisible="False" so pointer events pass through to the
                 graph (pan/zoom/select still work under the legend). -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                    CornerRadius="6" Padding="8,6"
                    IsHitTestVisible="False"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1">
                <!-- Semi-transparent panel: the graph shows through (no blur).
                     Only the background is transparent; the text stays opaque. -->
                <Border.Background>
                    <SolidColorBrush Color="#000" Opacity="0.5" />
                </Border.Background>
                <StackPanel Orientation="Vertical" Spacing="4">
                    <!-- Node color legend -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="10" Height="10" CornerRadius="3" Background="#3D7EBF" />
                        <TextBlock Text="parameter" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="#3D9E5F" Margin="8,0,0,0" />
                        <TextBlock Text="grip" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="#C77B3D" Margin="8,0,0,0" />
                        <TextBlock Text="action" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="#7A7A7A" Margin="8,0,0,0" />
                        <TextBlock Text="component" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="Transparent" BorderBrush="White" BorderThickness="2" Margin="8,0,0,0" />
                        <TextBlock Text="target" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                    </StackPanel>
                    <!-- Line-type legend: solid = value, dashed = lookup,
                         dashed orange = feedback arc. -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Line StartPoint="0,0" EndPoint="24,0" Stroke="#B09A9A9A" StrokeThickness="2" Stretch="None" VerticalAlignment="Center" />
                        <TextBlock Text="value" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Line StartPoint="0,0" EndPoint="24,0" Stroke="#B09A9A9A" StrokeThickness="2" StrokeDashArray="6,4" Stretch="None" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="lookup" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Line StartPoint="0,0" EndPoint="24,0" Stroke="#E8A33D" StrokeThickness="2" StrokeDashArray="6,4" Stretch="None" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="feedback" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Mini-map: always shows the whole graph at a fixed scale; the
                 highlighted rectangle tracks the visible area, and pressing
                 or dragging the map re-centers the main view. -->
            <local:MiniMapView x:Name="MiniMap"
                               Width="220" Height="150"
                               Margin="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" />
        </Grid>
    </DockPanel>
</Window>
