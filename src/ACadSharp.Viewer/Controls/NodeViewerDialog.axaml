<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:local="using:ACadSharp.Viewer.Controls"
        x:Class="ACadSharp.Viewer.Controls.NodeViewerDialog"
        Title="Node viewer"
        Width="900" Height="600"
        MinWidth="500" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Color legend -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                        <Border Width="10" Height="10" CornerRadius="3" Background="#3D7EBF" />
                        <TextBlock Text="parameter" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="#3D9E5F" Margin="8,0,0,0" />
                        <TextBlock Text="grip" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="#C77B3D" Margin="8,0,0,0" />
                        <TextBlock Text="action" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="#7A7A7A" Margin="8,0,0,0" />
                        <TextBlock Text="component" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        <Border Width="10" Height="10" CornerRadius="3" Background="Transparent" BorderBrush="White" BorderThickness="2" Margin="8,0,0,0" />
                        <TextBlock Text="target" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                    </StackPanel>
                    <!-- Avalonia 12 removed the ToolTip attached property, so the
                         buttons are icon-only (the legend explains the colors). -->
                    <Button Click="OnFitClick" Focusable="False">
                        <ui:FASymbolIcon Symbol="FullScreen" />
                    </Button>
                    <Button Click="OnZoomInClick" Focusable="False">
                        <ui:FASymbolIcon Symbol="ZoomIn" />
                    </Button>
                    <Button Click="OnZoomOutClick" Focusable="False">
                        <ui:FASymbolIcon Symbol="ZoomOut" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="Header" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="Details" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondary}"
                       Text="Click a node to see its details. Hover a node or edge for a quick summary. Scroll to zoom, drag to pan." />
        </Border>
        <local:NodeGraphView x:Name="Graph" />
    </DockPanel>
</Window>
