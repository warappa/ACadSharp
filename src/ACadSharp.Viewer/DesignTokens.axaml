<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="ACadSharp.Viewer.DesignTokens">

    <!-- Theme-invariant, at the root of the dictionary.
         (x:Double compiles; x:CornerRadius does NOT resolve in Avalonia 12 —
         use the plain CornerRadius element. BoxShadows has no TypeConverter,
         so shadows live in DesignTokenShadows.cs and are referenced via x:Static.) -->
    <!-- Font sizes sit on the design language's type ramp (12 14 16 18 20 ...):
          caption=12, body=14, subtitle=20, code=12. 11 and 16-as-subtitle were
         off-ramp: the ramp's Subtitle is 20/28 SemiBold, per
         docs/design/fluent2-design-language.md §2.2. -->
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="SubtitleFontSize">20</x:Double>
    <x:Double x:Key="CodeFontSize">12</x:Double>
    <FontFamily x:Key="FontFamilyCode">Cascadia Code, Consolas, monospace</FontFamily>
    <!-- Corner scale (8 4 0): top-level surfaces (the dialog overlay) are 8,
          in-page surfaces (node boxes, legend swatches) are 4, and 0 for the
          squared-off edge-label masks (set inline). -->
    <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SwatchCornerRadius">4</CornerRadius>

    <!-- Spacing scale (px): 4 8 12 16 24 32 48 ... (the design language's
         "use the scale, not ad-hoc values"). Only the steps the app actually
         uses are named. Sub-scale micro-paddings (1/2) and stroke widths
         (2/3) stay literal — the scale governs layout spacing, not the
         breathing room of a glyph.
         These x:Double tokens are consumed by DOUBLE-typed properties only
         (Spacing, FontSize, ...): the Avalonia 12.1.3 XAML runtime setter
         cast-fails on a Double for a Thickness property (Margin/Padding),
         with or without a TypeConverter — so Margin/Padding stay literal
         (normalized to this scale). Verified: a {StaticResource} inside a
         Thickness list compiles but the generated XamlDynamicSetter does a
         direct (Thickness) cast and the app dies at construction. -->
    <x:Double x:Key="Space2">4</x:Double>
    <x:Double x:Key="Space4">8</x:Double>
    <x:Double x:Key="Space6">12</x:Double>
    <x:Double x:Key="Space8">16</x:Double>
    <x:Double x:Key="Space12">24</x:Double>

    <!-- Fixed (brand) colors: used identically in both themes. The dialog
         scrim (a semi-transparent black — mode-agnostic, per the design
         language), the status-bar colors, and the accent presets the
         settings flyout applies to the theme's CustomAccentColor. -->
    <Color x:Key="ScrimColor">#000000</Color>
    <Color x:Key="StatusErrorColor">#D13438</Color>
    <Color x:Key="StatusSuccessColor">#2E9E5B</Color>
    <Color x:Key="AccentChoiceBlue">#0078D4</Color>
    <Color x:Key="AccentChoiceRed">#D13438</Color>
    <Color x:Key="AccentChoiceGreen">#2E9E5B</Color>
    <Color x:Key="AccentChoicePurple">#8764B8</Color>

    <!-- The feedback (hover/selection) orange is a fixed hue, read against
         the canvas at the 3px highlight stroke in both themes. -->
    <Color x:Key="FeedbackColor">#E8A33D</Color>

    <!-- The Win11 caption-button close hover: Windows paints it with the same
          red in BOTH themes (#C42B1C hover, a darker pressed step, a white
          glyph), so these are fixed brushes, not theme-dependent colors.
          Brushes (not colors) because a Style setter needs the brush. -->
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#AC2722" />
    <SolidColorBrush x:Key="CaptionCloseGlyphBrush" Color="#FFFFFF" />

    <!-- Theme-dependent (mirrors the FA 3.0.2 pattern: plain keys in
         Default/Dark sub-dictionaries; Default = Light). The node colors share
         the legend's keys (NodeViewerDialog) so code-drawn nodes and the legend
         agree across theme switches; the Light fill values are the Dark values
         moved to darker neutrals (hierarchy by lightness, not hue).

         The node TEXT is theme-dependent because the fills invert between
         themes: the Light fills are dark (white text — worst case #6E6E6E,
         5.1:1) and the Dark fills are light (black text — worst case #7A7A7A,
         4.89:1; every fill passes 4.5:1 in its own theme). The port labels
         (PortColor) and the hover ring (NodeHover) sit on the CANVAS, so they
         take the canvas's own polarity; NodeTargetStroke / EdgeLine /
         EdgeLabel / ViewRect are the canvas neutrals. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="NodeParameterColor">#0F6CBD</Color>
            <Color x:Key="NodeGripColor">#0F7B0F</Color>
            <Color x:Key="NodeActionColor">#9D5D00</Color>
            <Color x:Key="NodeComponentColor">#6E6E6E</Color>
            <Color x:Key="NodeOtherColor">#6F529B</Color>
            <Color x:Key="NodeTextColor">#FFFFFF</Color>
            <Color x:Key="NodeTextSecondaryColor">#CCFFFFFF</Color>
            <Color x:Key="NodeTargetStrokeColor">#4D4D4D</Color>
            <Color x:Key="NodeHoverColor">#333333</Color>
            <Color x:Key="PortColor">#1A1A1A</Color>
            <Color x:Key="EdgeLineColor">#B0707070</Color>
            <Color x:Key="EdgeLabelColor">#E0616161</Color>
            <Color x:Key="ViewRectColor">#30000000</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="NodeParameterColor">#3D7EBF</Color>
            <Color x:Key="NodeGripColor">#3D9E5F</Color>
            <Color x:Key="NodeActionColor">#C77B3D</Color>
            <Color x:Key="NodeComponentColor">#7A7A7A</Color>
            <Color x:Key="NodeOtherColor">#8E6FBF</Color>
            <Color x:Key="NodeTextColor">#000000</Color>
            <Color x:Key="NodeTextSecondaryColor">#CC000000</Color>
            <Color x:Key="NodeTargetStrokeColor">#FFFFFF</Color>
            <Color x:Key="NodeHoverColor">#F0F0F0</Color>
            <Color x:Key="PortColor">#FFFFFF</Color>
            <Color x:Key="EdgeLineColor">#B09A9A9A</Color>
            <Color x:Key="EdgeLabelColor">#E0808080</Color>
            <Color x:Key="ViewRectColor">#30FFFFFF</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
