<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:svc="using:ACadSharp.Viewer.Services"
        xmlns:conv="using:ACadSharp.Viewer.Converters"
        x:Class="ACadSharp.Viewer.MainWindow"
        Title="ACadSharp Viewer"
        Width="1100" Height="700"
        MinWidth="700" MinHeight="400"
        KeyDown="OnKeyDown"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource SolidBackgroundFillColorBase}">
    <Window.Resources>
        <conv:ValueForegroundConverter x:Key="ValueForeground" />
    </Window.Resources>
    <!-- The decorations theme: Avalonia keeps the frame (border, shadow, resize
         grips) and draws NO caption of its own. TitleBarHeight resolves to
         TitleBarHeightOverride when it is set, and the override comes from
         ExtendClientAreaTitleBarHeightHint — so that hint is deliberately NOT set
         here; with it unset the theme default of 0 wins, HasTitleBar is false, and
         the PART_TitleBar / PART_TitleTextPanel / PART_OverlayPanel parts of the
         Fluent decorations template all stay hidden. That is what leaves our
         AppTitleStrip as the only caption; with the hint present Avalonia draws its
         own 34px caption (icon title text + its own caption buttons) on top of the
         strip — two titlebars again, both app-drawn. -->
    <Window.WindowDecorationsTheme>
        <ControlTheme TargetType="chrome:WindowDrawnDecorations"
                      BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
            <Setter Property="DefaultTitleBarHeight" Value="0" />
        </ControlTheme>
    </Window.WindowDecorationsTheme>
    <DockPanel>
        <!-- ============ App-drawn title strip (Windows 11 caption geometry) ========
             The app owns the caption bar: ExtendClientAreaToDecorationsHint pulls the
             client area up into the frame, and on X11/XWayland Program.cs sets
             X11PlatformOptions.EnableDrawnDecorations so Avalonia draws the border,
             shadow and resize grips and the window manager draws nothing. Avalonia
             12 routes the non-client input by role: this strip is the TitleBar
             (drag area), the caption buttons declare their own roles so they get the
             click instead of starting a window move. Win11 caption facts applied
             here: 34px strip, 16px left inset, the app glyph, title + (de-emphasized)
             file name, 46x32 caption buttons flush right with squared corners (they
             touch the window edge → corner scale 0) and the red close hover.
             Double-clicking the strip maximizes/restores (handled in code: on X11
             client-side decorations Avalonia 12.1 does not do it itself). -->
        <Border x:Name="AppTitleStrip" DockPanel.Dock="Top" Height="34"
                Background="{DynamicResource SolidBackgroundFillColorBase}"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space4}"
                            Margin="16,0,0,0" VerticalAlignment="Center">
                    <ui:FASymbolIcon Symbol="WeatherThunderstorm" FontSize="14"
                                     Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="ACadSharp Viewer" FontSize="{StaticResource CaptionFontSize}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Width="1" Height="12" Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" Margin="2,0" />
                    <TextBlock x:Name="FileNameText" FontSize="{StaticResource CaptionFontSize}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="480" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Classes="caption" Click="OnMinimizeClick"
                            chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                            PointerPressed="OnCaptionPointerPressed" ToolTip.Tip="Minimize">
                        <ui:FASymbolIcon Symbol="FullScreenMinimize" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximizeClick"
                            chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                            PointerPressed="OnCaptionPointerPressed" ToolTip.Tip="Maximize / Restore">
                        <ui:FASymbolIcon x:Name="MaximizeIcon" Symbol="FullScreenMaximize" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseButton" Classes="caption captionClose" Click="OnCloseClick"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton"
                            PointerPressed="OnCaptionPointerPressed" ToolTip.Tip="Close">
                        <ui:FASymbolIcon Symbol="Dismiss" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Command bar (Win11 CommandBar: primary left, utility right)
             No divider rule: Fluent separates the base layer from the content layer by
             *lightness* (the cards sit on the base background), not by contour. -->
        <Border DockPanel.Dock="Top" Padding="16,10,16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="{StaticResource Space4}">
                    <Button x:Name="OpenButton" Click="OnOpenClick" Padding="11,0,11,0" MinHeight="32">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                            <ui:FASymbolIcon Symbol="OpenFile" FontSize="16" />
                            <TextBlock Text="Open…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReloadButton" Click="OnReloadClick" IsEnabled="False" Padding="11,0,11,0" MinHeight="32">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                            <ui:FASymbolIcon Symbol="Refresh" FontSize="16" />
                            <TextBlock Text="Reload" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TablesButton" Click="OnTablesClick" IsEnabled="False" Padding="11,0,11,0" MinHeight="32"
                            ToolTip.Tip="Block properties tables — the decoded display tables of this document">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                            <ui:FASymbolIcon Symbol="View" FontSize="16" />
                            <TextBlock Text="Tables" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Utility group, right-aligned: icon-only 44px hot zones + tooltips
                     (Fitts: the labels are dropped, the tooltips carry them back). -->
                <Button x:Name="SettingsButton" Classes="iconCommand" DockPanel.Dock="Right"
                        ToolTip.Tip="Appearance — theme and accent">
                    <ui:FASymbolIcon Symbol="Settings" FontSize="16" />
                    <Button.Flyout>
                        <!-- Avalonia 12: FAMenuFlyout (FlyoutBase) has no Name property,
                             so it cannot be x:Named; MainWindow holds a reference
                             via SettingsButton.Flyout instead. -->
                        <ui:FAMenuFlyout Placement="Bottom">
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeLightItem" GroupName="theme" Text="Light theme"
                                                      IconSource="WeatherSunny" CommandParameter="Light" Click="OnSettingsThemeClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeDarkItem" GroupName="theme" Text="Dark theme"
                                                      IconSource="DarkTheme" CommandParameter="Dark" IsChecked="True" Click="OnSettingsThemeClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeHcItem" GroupName="theme" Text="High contrast"
                                                      IconSource="Highlight" CommandParameter="HighContrast" Click="OnSettingsThemeClick" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentDefaultItem" GroupName="accent" Text="Default accent"
                                                      IconSource="ColorFill" CommandParameter="AccentDefault" IsChecked="True" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentBlueItem" GroupName="accent" Text="Blue accent"
                                                      IconSource="ColorFill" CommandParameter="AccentBlue" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentRedItem" GroupName="accent" Text="Red accent"
                                                      IconSource="ColorFill" CommandParameter="AccentRed" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentGreenItem" GroupName="accent" Text="Green accent"
                                                      IconSource="ColorFill" CommandParameter="AccentGreen" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentPurpleItem" GroupName="accent" Text="Purple accent"
                                                      IconSource="ColorFill" CommandParameter="AccentPurple" Click="OnSettingsAccentClick" />
                        </ui:FAMenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- De-accented theme toggle: a plain Button (the ToggleButton's checked
                     state paints the accent, which made the top row shouty). Icon-only;
                     it shows the current theme and switches dark<->light. -->
                <Button x:Name="DarkThemeToggle" Classes="iconCommand" DockPanel.Dock="Right"
                        Click="OnThemeToggleClick" ToolTip.Tip="Switch between the light and dark theme">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                        <ui:FASymbolIcon x:Name="ThemeIcon" Symbol="DarkTheme" FontSize="16" />
                        <!-- Kept for the code-behind (it sets the theme name); the
                             icon-only button shows the glyph, the tooltip the words. -->
                        <TextBlock x:Name="ThemeLabel" Text="Dark" IsVisible="False" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ============ Fixed status slot (Nielsen #1: persistent system status) ====
             A 28px caption-size bar that never appears/disappears, so it never shifts
             the layout. 16px inset aligns its text with the panes' inner text. -->
        <Border DockPanel.Dock="Bottom" Classes="statusBar">
            <TextBlock x:Name="StatusText" FontSize="{StaticResource CaptionFontSize}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                       Text="Open a .dwg or .dxf file (Ctrl+O) or drag &amp; drop one onto the window." />
        </Border>

        <!-- Status lives in a fixed bottom slot (StatusText) so it never shifts the
             layout; the transient InfoBar (which pushed the content when it opened)
             is gone. The outer row-0 slot is intentionally empty (0 height). -->
        <Grid RowDefinitions="Auto,*">
            <!-- The content layer: two Fluent cards (fill + 1px contour + the 8px
                 corner, no drop shadow) inset on the base background, separated by a
                 hairline with 12px gutters instead of a heavy splitter bar. -->
            <Grid Grid.Row="1" ColumnDefinitions="360,Auto,*" Margin="16,8,16,8">
                <Border Grid.Column="0" Classes="pane">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="12,12,12,6">
                            <!-- Win11 search box: the themed TextBox carries its own
                                 focus underline + 4px corner, with the Find glyph as
                                 InnerLeftContent. (3.0.2 ships no SearchBox control.) -->
                            <TextBox Grid.Column="0" x:Name="TreeSearchBox" MinHeight="32" Margin="0,0,8,0"
                                     PlaceholderText="Search blocks…" TextChanged="OnTreeSearchTextChanged">
                                <TextBox.InnerLeftContent>
                                    <ui:FASymbolIcon Symbol="Find" FontSize="16" Margin="9,0,0,0"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <Button Grid.Column="1" Classes="iconCommand" Click="OnExpandAllClick"
                                    ToolTip.Tip="Expand all blocks">
                                <ui:FASymbolIcon Symbol="ChevronDown" FontSize="16" />
                            </Button>
                            <Button Grid.Column="2" Classes="iconCommand" Click="OnCollapseAllClick"
                                    ToolTip.Tip="Collapse all blocks">
                                <ui:FASymbolIcon Symbol="ChevronUp" FontSize="16" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TreeView x:Name="BlockTree" Margin="8,0,8,4" SelectionChanged="OnTreeSelectionChanged">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="svc:BlockTreeNode" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- dynamic block: real FASymbol (lightning), not an invented glyph -->
                                            <ui:FASymbolIcon Symbol="WeatherThunderstorm" FontSize="12" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                             IsVisible="{Binding IsDynamic}" />
                                            <!-- reference-count badge (a number, not an icon) -->
                                            <TextBlock Text="{Binding ReferenceBadge}" FontSize="{StaticResource CaptionFontSize}"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       IsVisible="{Binding ShowReferenceBadge}" />
                                            <!-- pure reference cycle root: real FASymbol (refresh) -->
                                            <ui:FASymbolIcon Symbol="Refresh" FontSize="12" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                             IsVisible="{Binding IsCycleRoot}" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <!-- Empty state: the Win11 pattern — a large muted glyph, a
                                 Subtitle title, a Caption description. The C#
                                 (ApplyTreeFilter) swaps the text/icon per state. -->
                            <StackPanel x:Name="TreeEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="{StaticResource Space4}" Margin="24">
                                <ui:FASymbolIcon x:Name="TreeEmptyIcon" Symbol="OpenFile" FontSize="32"
                                                 Foreground="{DynamicResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TreeEmptyTitle" Classes="emptyTitle" Text="No file loaded" />
                                <TextBlock x:Name="TreeEmptyDesc" Classes="emptyDesc" MaxWidth="220"
                                           Text="Open a .dwg or .dxf (Ctrl+O) to explore its dynamic blocks and evaluation graphs." />
                            </StackPanel>
                        </Grid>
                        <!-- Footer legend: a flat row with a top hairline (the card-in-card
                             box read as noise). The markers mirror the tree rows exactly
                             (same FASymbols + the ×N badge), so it explains real rows. -->
                        <Border Grid.Row="2" Margin="12,0,12,0" Padding="0,8" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="WeatherThunderstorm" FontSize="12"
                                                     Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="dynamic" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="×N" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="referenced N times" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="Refresh" FontSize="12"
                                                     Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="cycle root" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TreeSummary" FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <!-- Fluent separates by lightness: a 1px hairline with gutters, not a
                     4px bar. The splitter is a 13px transparent hot zone over the
                     hairline (its own template stays the theme's — the resize logic
                     reads the control's bounds, so only the paint changes). -->
                <Grid Grid.Column="1" Width="13">
                    <Border Width="1" Height="120" Classes="divider" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <GridSplitter Width="13" Background="Transparent" />
                </Grid>
                <Border Grid.Column="2" Classes="pane">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <!-- Content header: the Subtitle step (20 SemiBold) names the
                             selected block, the Caption step carries the evaluation
                             status, then one hairline. The block header is the loudest
                             text in the pane (the data outranks the chrome). -->
                        <StackPanel Grid.Row="0" Margin="16,12,16,0" Spacing="2">
                            <TextBlock x:Name="BlockHeader" FontWeight="SemiBold" FontSize="{StaticResource SubtitleFontSize}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="EvalStatus" FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Margin="16,8,16,0" Classes="divider" />
                        <Grid Grid.Row="3">
                            <!-- Win11 GridView density (set by FluentStyles): no body
                                 gridlines, 36px header, 32px rows, header rule only.
                                 Column budget fits the pane at MinWidth (no clipped
                                 headers): the fixed columns sum to 514 and Description
                                 takes the slack from 150 up. Values are right-aligned
                                 monospace (tabular) so digits column-align. -->
                            <DataGrid x:Name="PropertyGrid" x:DataType="svc:PropertyItem" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False" Margin="8,0,8,0">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Name" Width="126" MinWidth="96">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="svc:PropertyItem">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Description" Width="*" MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="svc:PropertyItem">
                                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Type" Width="74" MinWidth="74">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="svc:PropertyItem">
                                                <TextBlock Text="{Binding TypeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Inputs" Width="90" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="svc:PropertyItem">
                                                <TextBlock Text="{Binding InputsText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Outputs" Width="98" MinWidth="98">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="svc:PropertyItem">
                                                <TextBlock Text="{Binding OutputsText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Value" Width="86" MinWidth="86">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <!-- Header text follows the content alignment (Win11 GridView): the
                                             numeric column reads as one right-aligned block. -->
                                        <DataTemplate>
                                            <TextBlock Text="Value" HorizontalAlignment="Right" TextAlignment="Right" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="svc:PropertyItem">
                                                <!-- Right-aligned: numerics scan as a column.
                                                     Monospace + the tabular-nums setting keep
                                                     digits aligned across rows. -->
                                                <TextBlock Text="{Binding ValueOnlyText}"
                                                           Foreground="{Binding HasValue, Converter={StaticResource ValueForeground}}"
                                                           FontFamily="{StaticResource FontFamilyCode}"
                                                           FontSize="{StaticResource CodeFontSize}"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Info" Width="66" MinWidth="66">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="svc:PropertyItem">
                                                <!-- Icon-only 32px target + tooltip. Uses the enum
                                                     glyph (ContactInfo) through FASymbolIcon's own
                                                     remap — the previous raw 0xF05A code point
                                                     rendered as a clipped half-disc. -->
                                                <Button Click="OnInfoClick" Tag="{Binding}" Width="32" Height="28" Padding="0"
                                                        HorizontalAlignment="Center" ToolTip.Tip="About this property">
                                                    <ui:FASymbolIcon Symbol="ContactInfo" FontSize="16" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Empty state (same Win11 pattern as the tree pane). -->
                            <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="{StaticResource Space4}" Margin="24">
                                <ui:FASymbolIcon x:Name="PlaceholderIcon" Symbol="OpenFile" FontSize="32"
                                                 Foreground="{DynamicResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PlaceholderTitle" Classes="emptyTitle" Text="No file loaded" />
                                <TextBlock x:Name="PlaceholderDesc" Classes="emptyDesc" MaxWidth="300"
                                           Text="Open a .dwg or .dxf (Ctrl+O) to explore its dynamic blocks and evaluation graphs." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <ui:FAProgressRing x:Name="LoadingRing" Grid.Column="2" IsVisible="False" Width="48" Height="48"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <!-- First-run teaching tip: its template root is a Left/Top-aligned
                 Border, so the element (spanning both rows) only intercepts
                 input over the visible card, not the content behind it. -->
            <ui:FATeachingTip x:Name="IntroTip"
                              Title="Explore dynamic blocks"
                              Subtitle="Open a file, select a dynamic block, and press the info icon next to a value to see its evaluation graph."
                              PreferredPlacement="Bottom"
                              IsLightDismissEnabled="True"
                              ActionButtonContent="Got it"
                              ActionButtonClick="OnIntroTipActionClick" />
        </Grid>
    </DockPanel>
</Window>
