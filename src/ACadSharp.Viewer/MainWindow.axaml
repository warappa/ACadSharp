<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:ACadSharp.Viewer.Services"
        xmlns:conv="using:ACadSharp.Viewer.Converters"
        x:Class="ACadSharp.Viewer.MainWindow"
        Title="ACadSharp Viewer"
        Width="1100" Height="700"
        MinWidth="700" MinHeight="400"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <conv:ValueForegroundConverter x:Key="ValueForeground" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ACadSharp Viewer" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <Button x:Name="OpenButton" Click="OnOpenClick" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="Open…" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReloadButton" Click="OnReloadClick" IsEnabled="False" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Refresh" />
                            <TextBlock Text="Reload" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Padding="8,4" Focusable="False">
                    <ui:FASymbolIcon Symbol="Settings" />
                    <Button.Flyout>
                        <!-- Avalonia 12: FAMenuFlyout (FlyoutBase) has no Name property,
                             so it cannot be x:Named; MainWindow holds a reference
                             via SettingsButton.Flyout instead. -->
                        <ui:FAMenuFlyout Placement="Bottom">
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeLightItem" GroupName="theme" Text="Light theme"
                                                      IconSource="WeatherSunny" CommandParameter="Light" Click="OnSettingsThemeClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeDarkItem" GroupName="theme" Text="Dark theme"
                                                      IconSource="DarkTheme" CommandParameter="Dark" IsChecked="True" Click="OnSettingsThemeClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeHcItem" GroupName="theme" Text="High contrast"
                                                      IconSource="Highlight" CommandParameter="HighContrast" Click="OnSettingsThemeClick" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentDefaultItem" GroupName="accent" Text="Default accent"
                                                      IconSource="ColorFill" CommandParameter="AccentDefault" IsChecked="True" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentBlueItem" GroupName="accent" Text="Blue accent"
                                                      IconSource="ColorFill" CommandParameter="AccentBlue" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentRedItem" GroupName="accent" Text="Red accent"
                                                      IconSource="ColorFill" CommandParameter="AccentRed" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentGreenItem" GroupName="accent" Text="Green accent"
                                                      IconSource="ColorFill" CommandParameter="AccentGreen" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentPurpleItem" GroupName="accent" Text="Purple accent"
                                                      IconSource="ColorFill" CommandParameter="AccentPurple" Click="OnSettingsAccentClick" />
                        </ui:FAMenuFlyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Name="DarkThemeToggle" DockPanel.Dock="Right" IsChecked="True" Click="OnThemeToggleClick" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon x:Name="ThemeIcon" Symbol="DarkTheme" />
                        <TextBlock x:Name="ThemeLabel" Text="Dark" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorTertiary}" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="10,5">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextFillColorTertiary}" Text="Open a .dwg or .dxf file (Ctrl+O) or drag &amp; drop one onto the window." />
        </Border>
        <Grid RowDefinitions="Auto,*">
            <ui:FAInfoBar x:Name="InfoBar" Grid.Row="0" IsOpen="False" IsClosable="True"
                         Margin="8,8,8,0" />
            <Grid Grid.Row="1" ColumnDefinitions="360,Auto,*">
                <Border Grid.Column="0" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="8,8,8,4">
                            <TextBox x:Name="TreeSearchBox" Grid.Column="0" Margin="0,0,6,0"
                                     PlaceholderText="Search blocks…" TextChanged="OnTreeSearchTextChanged" />
                            <Button Grid.Column="1" Click="OnExpandAllClick" Padding="6,2" Focusable="False">
                                <ui:FASymbolIcon Symbol="ChevronDown" />
                            </Button>
                            <Button Grid.Column="2" Click="OnCollapseAllClick" Padding="6,2" Focusable="False">
                                <ui:FASymbolIcon Symbol="ChevronUp" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TreeView x:Name="BlockTree" Margin="4,0,4,4" SelectionChanged="OnTreeSelectionChanged">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="svc:BlockTreeNode" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <TextBlock x:Name="TreeEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiary}"
                                       Text="No file loaded — open a .dwg or .dxf (Ctrl+O)" />
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="10,4,10,8">
                            <TextBlock Text="⚡ dynamic" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock Text="×N referenced N times" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock Text="⟳ cycle root" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock x:Name="TreeSummary" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource ControlStrokeColorDefault}" />
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                    <TextBlock x:Name="BlockHeader" Grid.Row="0" Margin="12,10,12,0" FontWeight="Bold" FontSize="16" />
                    <TextBlock x:Name="EvalStatus" Grid.Row="1" Margin="12,4,12,0" Foreground="{DynamicResource TextFillColorSecondary}" />
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="PropertyGrid" x:DataType="svc:PropertyItem" AutoGenerateColumns="False" IsReadOnly="True" Margin="12,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="90" />
                                <DataGridTemplateColumn Header="Value" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="svc:PropertyItem">
                                            <TextBlock Text="{Binding ValueOnlyText}"
                                                       Foreground="{Binding HasValue, Converter={StaticResource ValueForeground}}"
                                                       FontFamily="Cascadia Code, Consolas, monospace"
                                                       FontSize="12" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Info" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="OnInfoClick" Tag="{Binding}" Padding="6,2">
                                                <ui:FASymbolIcon Symbol="ContactInfo" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="PlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" Text="No file loaded" />
                    </Grid>
                </Grid>
                <ui:FAProgressRing x:Name="LoadingRing" Grid.Column="2" IsVisible="False" Width="48" Height="48"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <!-- First-run teaching tip: its template root is a Left/Top-aligned
                 Border, so the element (spanning both rows) only intercepts
                 input over the visible card, not the content behind it. -->
            <ui:FATeachingTip x:Name="IntroTip"
                              Title="Explore dynamic blocks"
                              Subtitle="Open a file, select a ⚡ dynamic block, and press ⓘ next to a value to see its evaluation graph."
                              PreferredPlacement="Bottom"
                              IsLightDismissEnabled="True"
                              ActionButtonContent="Got it"
                              ActionButtonClick="OnIntroTipActionClick" />
        </Grid>
    </DockPanel>
</Window>
