<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:ACadSharp.Viewer.Services"
        x:Class="ACadSharp.Viewer.MainWindow"
        Title="ACadSharp Viewer"
        Width="1100" Height="700"
        MinWidth="700" MinHeight="400"
        KeyDown="OnKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ACadSharp Viewer" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <Button x:Name="OpenButton" Click="OnOpenClick" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="Open…" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReloadButton" Click="OnReloadClick" IsEnabled="False" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Refresh" />
                            <TextBlock Text="Reload" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ToggleButton x:Name="DarkThemeToggle" DockPanel.Dock="Right" IsChecked="True" Click="OnThemeToggleClick" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon x:Name="ThemeIcon" Symbol="DarkTheme" />
                        <TextBlock x:Name="ThemeLabel" Text="Dark" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorTertiary}" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="10,5">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextFillColorTertiary}" Text="Open a .dwg or .dxf file (Ctrl+O) or drag &amp; drop one onto the window." />
        </Border>
        <Grid RowDefinitions="Auto,*">
            <ui:FAInfoBar x:Name="InfoBar" Grid.Row="0" IsOpen="False" IsClosable="True"
                         Margin="8,8,8,0" />
            <Grid Grid.Row="1" ColumnDefinitions="360,*">
                <Border Grid.Column="0" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,1,0">
                    <TreeView x:Name="BlockTree" Margin="4" SelectionChanged="OnTreeSelectionChanged">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="svc:BlockTreeNode" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                    <TextBlock x:Name="BlockHeader" Grid.Row="0" Margin="12,10,12,0" FontWeight="Bold" FontSize="16" />
                    <TextBlock x:Name="EvalStatus" Grid.Row="1" Margin="12,4,12,0" Foreground="{DynamicResource TextFillColorSecondary}" />
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="PropertyGrid" x:DataType="svc:PropertyItem" AutoGenerateColumns="False" IsReadOnly="True" Margin="12,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="120" />
                                <DataGridTemplateColumn Header="Info" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="OnInfoClick" Tag="{Binding}" Padding="6,2">
                                                <ui:FASymbolIcon Symbol="ContactInfo" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="PlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" Text="No file loaded" />
                    </Grid>
                </Grid>
                <ui:FAProgressRing x:Name="LoadingRing" IsVisible="False" Width="48" Height="48"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
