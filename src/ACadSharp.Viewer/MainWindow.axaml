<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:ACadSharp.Viewer.Services"
        xmlns:conv="using:ACadSharp.Viewer.Converters"
        x:Class="ACadSharp.Viewer.MainWindow"
        Title="ACadSharp Viewer"
        Width="1100" Height="700"
        MinWidth="700" MinHeight="400"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <conv:ValueForegroundConverter x:Key="ValueForeground" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,8" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="{StaticResource Space4}">
                    <TextBlock Text="ACadSharp Viewer" FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}" VerticalAlignment="Center" />
                    <Button x:Name="OpenButton" Click="OnOpenClick" Padding="10,0" MinHeight="32">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                            <ui:FASymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="Open…" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReloadButton" Click="OnReloadClick" IsEnabled="False" Padding="10,0" MinHeight="32">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                            <ui:FASymbolIcon Symbol="Refresh" />
                            <TextBlock Text="Reload" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Padding="10,0" MinHeight="32" Focusable="False"
                       ToolTip.Tip="Appearance — theme and accent">
                    <ui:FASymbolIcon Symbol="Settings" />
                    <Button.Flyout>
                        <!-- Avalonia 12: FAMenuFlyout (FlyoutBase) has no Name property,
                             so it cannot be x:Named; MainWindow holds a reference
                             via SettingsButton.Flyout instead. -->
                        <ui:FAMenuFlyout Placement="Bottom">
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeLightItem" GroupName="theme" Text="Light theme"
                                                      IconSource="WeatherSunny" CommandParameter="Light" Click="OnSettingsThemeClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeDarkItem" GroupName="theme" Text="Dark theme"
                                                      IconSource="DarkTheme" CommandParameter="Dark" IsChecked="True" Click="OnSettingsThemeClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="ThemeHcItem" GroupName="theme" Text="High contrast"
                                                      IconSource="Highlight" CommandParameter="HighContrast" Click="OnSettingsThemeClick" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentDefaultItem" GroupName="accent" Text="Default accent"
                                                      IconSource="ColorFill" CommandParameter="AccentDefault" IsChecked="True" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentBlueItem" GroupName="accent" Text="Blue accent"
                                                      IconSource="ColorFill" CommandParameter="AccentBlue" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentRedItem" GroupName="accent" Text="Red accent"
                                                      IconSource="ColorFill" CommandParameter="AccentRed" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentGreenItem" GroupName="accent" Text="Green accent"
                                                      IconSource="ColorFill" CommandParameter="AccentGreen" Click="OnSettingsAccentClick" />
                            <ui:FARadioMenuFlyoutItem x:Name="AccentPurpleItem" GroupName="accent" Text="Purple accent"
                                                      IconSource="ColorFill" CommandParameter="AccentPurple" Click="OnSettingsAccentClick" />
                        </ui:FAMenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- De-accented theme toggle: a plain Button (the ToggleButton's
                     checked state paints the accent, which made the top row shouty).
                     It shows the current theme (icon + label) and switches
                     dark<->light on click; high-contrast lives in the settings
                     flyout. -->
                <Button x:Name="DarkThemeToggle" DockPanel.Dock="Right" Click="OnThemeToggleClick" Padding="10,0" MinHeight="32">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                        <ui:FASymbolIcon x:Name="ThemeIcon" Symbol="DarkTheme" />
                        <TextBlock x:Name="ThemeLabel" Text="Dark" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorTertiary}" />
            </DockPanel>
        </Border>
        <!-- Fixed status slot: a persistent bar (top separator) whose text changes
             with state. It never appears/disappears, so it never shifts the layout. -->
        <Border DockPanel.Dock="Bottom" Padding="10,5"
                BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextFillColorTertiary}" Text="Open a .dwg or .dxf file (Ctrl+O) or drag &amp; drop one onto the window." />
        </Border>
        <!-- Status lives in a fixed bottom slot (StatusText) so it never shifts the
             layout; the transient InfoBar (which pushed the content when it opened)
             is gone. The outer row-0 slot is intentionally empty (0 height). -->
        <Grid RowDefinitions="Auto,*">
            <!-- Panes are cards (a subtle fill + border + rounded corner) inset from the
                 window edge and the command/status bars, so the layout reads as distinct
                 grouped regions. -->
            <Grid ColumnDefinitions="360,Auto,*" Margin="12,10,12,10">
                <Border Grid.Column="0" BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1"
                        CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefault}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="8,8,8,4">
                            <!-- Real search affordance: a Find (magnifier) icon inside a rounded
                                 field. 3.0.2 has no SearchBox control, so this is the idiomatic
                                 composition; the TextBox is borderless/transparent and the Border
                                 is the visual frame. -->
                            <Border Grid.Column="0" Margin="0,0,8,0" MinHeight="32" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorSecondary}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*">
                                    <ui:FASymbolIcon Grid.Column="0" Symbol="Find" FontSize="16"
                                                      Foreground="{DynamicResource TextFillColorSecondary}"
                                                      VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <TextBox Grid.Column="1" x:Name="TreeSearchBox" Background="Transparent"
                                             BorderThickness="0" Padding="0"
                                             PlaceholderText="Search blocks…" TextChanged="OnTreeSearchTextChanged" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Click="OnExpandAllClick" Padding="10,0" MinHeight="32" Focusable="False"
                                   ToolTip.Tip="Expand all blocks">
                                <ui:FASymbolIcon Symbol="ChevronDown" />
                            </Button>
                            <Button Grid.Column="2" Click="OnCollapseAllClick" Padding="10,0" MinHeight="32" Focusable="False"
                                   ToolTip.Tip="Collapse all blocks">
                                <ui:FASymbolIcon Symbol="ChevronUp" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TreeView x:Name="BlockTree" Margin="4,0,4,4" SelectionChanged="OnTreeSelectionChanged">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="svc:BlockTreeNode" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            <!-- dynamic block: real FASymbol (lightning), not an invented glyph -->
                                            <ui:FASymbolIcon Symbol="WeatherThunderstorm" FontSize="12" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource SystemFillColorCaution}"
                                                             IsVisible="{Binding IsDynamic}" />
                                            <!-- reference-count badge (a number, not an icon) -->
                                            <TextBlock Text="{Binding ReferenceBadge}" FontSize="{StaticResource CaptionFontSize}"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondary}"
                                                       IsVisible="{Binding ShowReferenceBadge}" />
                                            <!-- pure reference cycle root: real FASymbol (refresh) -->
                                            <ui:FASymbolIcon Symbol="Refresh" FontSize="12" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource SystemFillColorCaution}"
                                                             IsVisible="{Binding IsCycleRoot}" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <!-- Empty state: icon + title + description, centered over
                                 the (empty) tree. The C# (ApplyTreeFilter) swaps the
                                 title/description/icon per state and toggles visibility. -->
                            <StackPanel x:Name="TreeEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="{StaticResource Space2}">
                                <ui:FASymbolIcon x:Name="TreeEmptyIcon" Symbol="OpenFile" FontSize="24"
                                                 Foreground="{DynamicResource TextFillColorTertiary}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TreeEmptyTitle" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondary}" HorizontalAlignment="Center" Text="No file loaded" />
                                <TextBlock x:Name="TreeEmptyDesc" FontSize="{StaticResource BodyFontSize}"
                                           Foreground="{DynamicResource TextFillColorTertiary}" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="240"
                                           Text="Open a .dwg or .dxf (Ctrl+O) to explore its dynamic blocks and evaluation graphs." />
                            </StackPanel>
                        </Grid>
                        <!-- Footer legend: a contained card (hard edge), not floating labels.
                             The markers mirror the tree rows exactly (same FASymbols + ×N
                             badge), so the legend explains what the rows actually show. -->
                        <Border Grid.Row="2" Margin="8,4,8,8" Padding="8,6" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorSecondary}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefault}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="WeatherThunderstorm" FontSize="12"
                                                     Foreground="{DynamicResource SystemFillColorCaution}" VerticalAlignment="Center" />
                                    <TextBlock Text="dynamic" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextFillColorTertiary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="×N" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextFillColorSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Text="referenced N times" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextFillColorTertiary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="Refresh" FontSize="12"
                                                     Foreground="{DynamicResource SystemFillColorCaution}" VerticalAlignment="Center" />
                                    <TextBlock Text="cycle root" FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextFillColorTertiary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TreeSummary" Margin="8,0,0,0" FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextFillColorTertiary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource ControlStrokeColorDefault}" />
                <Border Grid.Column="2" BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1"
                        CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefault}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock x:Name="BlockHeader" Grid.Row="0" Margin="12,8,12,0" FontWeight="SemiBold" FontSize="{StaticResource SubtitleFontSize}" />
                    <TextBlock x:Name="EvalStatus" Grid.Row="1" Margin="12,4,12,0" Foreground="{DynamicResource TextFillColorSecondary}" />
                    <Grid Grid.Row="2">
                        <!-- DataGrid: mouse-resizable columns (CanUserResizeColumns) and
                             CharacterEllipsis on every text cell (DataGridTextColumn has no
                             trimming property, so the cells are templates). Long values
                             truncate with "…" instead of wrapping or overflowing. -->
                        <DataGrid x:Name="PropertyGrid" x:DataType="svc:PropertyItem" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserResizeColumns="True" Margin="12,8">
                            <DataGrid.Columns>
                                <!-- Column widths are tuned so the fixed columns sum to well
                                     under the pane width, leaving the flexible Description
                                     column real room (it collapses to 0 if the fixed sum
                                     exceeds the pane). The user can still drag any edge. -->
                                <DataGridTemplateColumn Header="Name" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="svc:PropertyItem">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Description" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="svc:PropertyItem">
                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Type" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="svc:PropertyItem">
                                            <TextBlock Text="{Binding TypeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Inputs" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="svc:PropertyItem">
                                            <TextBlock Text="{Binding InputsText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Outputs" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="svc:PropertyItem">
                                            <TextBlock Text="{Binding OutputsText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Value" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="svc:PropertyItem">
                                            <!-- Centered both ways; trims with an ellipsis when the
                                                 value is wider than the (resizable) column. -->
                                            <TextBlock Text="{Binding ValueOnlyText}"
                                                       Foreground="{Binding HasValue, Converter={StaticResource ValueForeground}}"
                                                       FontFamily="{StaticResource FontFamilyCode}"
                                                       FontSize="{StaticResource CodeFontSize}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Info" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="svc:PropertyItem">
                                            <Button Click="OnInfoClick" Tag="{Binding}" Padding="8,2" ToolTip.Tip="About this property">
                                                <!-- Real Microsoft "info" i-in-circle. It is NOT in the 442-value
                                                     FASymbol enum, so it is rendered straight from the bundled
                                                     FluentAvalana font (code point 0xF05A) instead of the old
                                                     ContactInfo (user) icon. (Avalonia 12 dropped the FontIcon
                                                     control, so a TextBlock on the font is used.) -->
                                                <TextBlock Text="&#xF05A;" FontFamily="avares://FluentAvalana/Fonts/FluentAvalana.ttf"
                                                           FontSize="16" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- Empty state: icon + title + description, centered over the
                             (empty) property grid. The C# swaps the title/description/
                             icon per state and toggles visibility. -->
                        <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="{StaticResource Space2}">
                            <ui:FASymbolIcon x:Name="PlaceholderIcon" Symbol="OpenFile" FontSize="24"
                                             Foreground="{DynamicResource TextFillColorTertiary}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PlaceholderTitle" FontSize="{StaticResource SubtitleFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondary}" HorizontalAlignment="Center" Text="No file loaded" />
                            <TextBlock x:Name="PlaceholderDesc" FontSize="{StaticResource BodyFontSize}"
                                       Foreground="{DynamicResource TextFillColorTertiary}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="320"
                                       Text="Open a .dwg or .dxf (Ctrl+O) to explore its dynamic blocks and evaluation graphs." />
                        </StackPanel>
                    </Grid>
                </Grid>
                </Border>
                <ui:FAProgressRing x:Name="LoadingRing" Grid.Column="2" IsVisible="False" Width="48" Height="48"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <!-- First-run teaching tip: its template root is a Left/Top-aligned
                 Border, so the element (spanning both rows) only intercepts
                 input over the visible card, not the content behind it. -->
            <ui:FATeachingTip x:Name="IntroTip"
                              Title="Explore dynamic blocks"
                              Subtitle="Open a file, select a dynamic block, and press the info icon next to a value to see its evaluation graph."
                              PreferredPlacement="Bottom"
                              IsLightDismissEnabled="True"
                              ActionButtonContent="Got it"
                              ActionButtonClick="OnIntroTipActionClick" />
        </Grid>
    </DockPanel>
</Window>
