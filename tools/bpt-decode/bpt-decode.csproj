<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>bpt-decode</AssemblyName>
    <!-- Signed with the library key so it can reach ACadSharp internals (the _cadObjects
         field, the BlockPropertiesTable.RawTail), exactly like the other tools. -->
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>../../src/ACadSharp.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../../src/ACadSharp/ACadSharp.csproj" />
  </ItemGroup>
</Project>
